&control
  calculation = 'scf'
  prefix = 'ethylene'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  verbosity = 'high'
/
&system
  ibrav = 1
  celldm(1) = 26.456166
  nat = 6
  ntyp = 2
  ecutwfc = 30.0
  ecutrho = 240.0
  occupations = 'fixed'
  nbnd = 12
/
&electrons
  conv_thr = 1.0d-6
  mixing_beta = 0.4
/
ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
  H  1.008  H.pbe-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS angstrom
  C  7.000000  7.000000  7.667000
  C  7.000000  7.000000  6.333000
  H  7.000000  7.923000  8.237000
  H  7.000000  6.077000  8.237000
  H  7.000000  7.923000  5.763000
  H  7.000000  6.077000  5.763000
K_POINTS gamma
